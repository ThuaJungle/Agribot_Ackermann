<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="inertial_macros.xacro"/>

    <xacro:property name="chassis_length" value="0.6"/>
    <xacro:property name="chassis_width" value="0.46"/>
    <xacro:property name="chassis_height" value="0.345"/>
    <xacro:property name="wheel_radius" value="0.075"/>
    <xacro:property name="wheel_thickness" value="0.05"/>
    <xacro:property name="wheel_base" value="0.38"/>   
    <xacro:property name="track_width" value="0.51"/>
    <xacro:property name="chassis_mass" value="20.0"/>
    <xacro:property name="wheel_mass" value="1.0"/>

    <material name="white">
      <color rgba="1 1 1 1"/>
    </material>
    <material name="red">
      <color rgba="1 0 0 1"/>
    </material>
    <material name="orange">
      <color rgba="1 0.3 0.1 1"/>
    </material>
    <material name="black">
      <color rgba="0 0 0 1"/>
    </material>
    <material name="blue">
      <color rgba="0.2 0.2 1 1"/>
    </material>
    <material name="green">
      <color rgba="0 1 0 1"/>
    </material>
     <material name="yellow">
      <color rgba="1 1 0 1"/>
    </material>
    

    <link name="base_link"></link>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="base_footprint"></link>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 ${wheel_radius}"/>
    </joint>

    <link name="chassis">
        <visual>
            <origin xyz="${wheel_base/2} 0 ${chassis_height/2}" rpy="0 0 0"/> 
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="${chassis_length/2} 0 ${chassis_height/2}"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="${chassis_length/2} 0 ${chassis_height/2}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <xacro:macro name="rear_wheel" params="prefix y_offset">
        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
                </geometry>
                <material name="yellow"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>1.0</mu>
                            <mu2>1.0</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <xacro:inertial_cylinder mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_thickness}">
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="chassis"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="0 ${y_offset} 0" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <mimic joint="rear_axle_joint" multiplier="1.0" offset="0.0"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="front_steering_wheel" params="prefix y_offset">
        <link name="${prefix}_steering_link">
            <visual>
                <geometry>
                    <box size="0.01 0.01 0.01"/>
                </geometry>
            </visual> 
            <xacro:inertial_box mass="0.1" x="0.01" y="0.01" z="0.01">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_box>
        </link>

        <joint name="${prefix}_steering_joint" type="revolute">
            <parent link="chassis"/>
            <child link="${prefix}_steering_link"/>
            <origin xyz="${wheel_base} ${y_offset} 0" rpy="0 0 0"/>
            <axis xyz="0 0 1"/> 
            <limit lower="-0.5" upper="0.5" effort="10" velocity="10.0"/>
            <mimic joint="steering_joint" multiplier="1.0" offset="0.0"/>
        </joint>

        <link name="${prefix}_front_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
                </geometry>
                <material name="yellow"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>1.0</mu>
                            <mu2>1.0</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <xacro:inertial_cylinder mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_thickness}">
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <joint name="${prefix}_front_wheel_joint" type="continuous">
            <parent link="${prefix}_steering_link"/>
            <child link="${prefix}_front_wheel"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <axis xyz="0 1 0"/> 
            <mimic joint="rear_axle_joint" multiplier="1.0" offset="0.0"/>
        </joint>
    </xacro:macro>

    <xacro:rear_wheel prefix="left_rear" y_offset="${track_width/2}"/>
    <xacro:rear_wheel prefix="right_rear" y_offset="${-track_width/2}"/>
    <xacro:front_steering_wheel prefix="left_front" y_offset="${track_width/2}"/>
    <xacro:front_steering_wheel prefix="right_front" y_offset="${-track_width/2}"/>

    <link name="virtual_steering_link">
        <xacro:inertial_box mass="0.01" x="0.01" y="0.01" z="0.01">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>
    <joint name="steering_joint" type="revolute">
        <parent link="chassis"/>
        <child link="virtual_steering_link"/>
        <origin xyz="${wheel_base} 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.541" upper="0.471" effort="10" velocity="1.0"/>
    </joint>

    <link name="virtual_rear_wheel_link">
        <xacro:inertial_cylinder mass="0.01" radius="0.01" length="0.01">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <joint name="rear_axle_joint" type="continuous">
        <parent link="chassis"/>
        <child link="virtual_rear_wheel_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.02 0.02 0.005"/> 
            </geometry>
            <material name="black"/>
        </visual>
    </link>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>  
        <child link="imu_link"/>
        <origin xyz="0.1 0 0.05" rpy="0 0 0"/> 
    </joint>

    <link name="gps_link">
        <visual>
            <geometry>
                <box size="0.05 0.05 0.02"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="gps_joint" type="fixed">
        <parent link="base_link"/>
        <child link="gps_link"/>
        <origin xyz="0 0.1 0.1" rpy="0 0 0"/> 
    </joint>

</robot>